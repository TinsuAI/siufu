#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Pre-commit hook to run linters and formatters

echo "Running pre-commit checks..."

# Frontend linting and formatting
if [ -d "frontend" ]; then
  echo "Checking frontend..."
  cd frontend

  # Run ESLint on staged TypeScript/TSX files
  STAGED_TS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.tsx\?$' || true)
  if [ -n "$STAGED_TS_FILES" ]; then
    echo "Running ESLint on frontend files..."
    npx eslint $STAGED_TS_FILES --fix --max-warnings=0 || exit 1
    git add $STAGED_TS_FILES
  fi

  # Run Prettier on all staged files
  STAGED_FRONTEND_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '^frontend/' || true)
  if [ -n "$STAGED_FRONTEND_FILES" ]; then
    echo "Running Prettier on frontend files..."
    npx prettier --write $STAGED_FRONTEND_FILES || exit 1
    git add $STAGED_FRONTEND_FILES
  fi

  cd ..
fi

# Backend linting
if [ -d "backend" ]; then
  echo "Checking backend..."
  cd backend

  # Run Ruff on staged Python files
  STAGED_PY_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)
  if [ -n "$STAGED_PY_FILES" ]; then
    echo "Running Ruff on backend files..."
    source venv/bin/activate
    ruff check --fix $STAGED_PY_FILES || exit 1
    git add $STAGED_PY_FILES
    deactivate
  fi

  cd ..
fi

echo "Pre-commit checks passed!"
