# ================================
# Production Environment Variables
# ================================
#
# This file serves as a template for production deployment.
# The actual .env file will be created by GitHub Actions during deployment.
#
# ALL values below should be configured as GitHub Secrets.
# See docs/DEPLOYMENT.md for detailed setup instructions.
#
# ================================

# ================================
# Database Configuration
# ================================

# PostgreSQL database name (default: customs_db)
POSTGRES_DB=siufu

# PostgreSQL password
# GitHub Secret: POSTGRES_PASSWORD
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}

# Full database URL for backend connection
# Uses internal Docker network name 'postgres'
DATABASE_URL=postgresql+asyncpg://postgres:${POSTGRES_PASSWORD}@postgres:5432/siufu
# ================================
# Redis Configuration
# ================================

# Redis connection URL for caching
# Uses internal Docker network name 'redis'
REDIS_URL=redis://redis:6379/0

# Celery broker URL (uses Redis)
CELERY_BROKER_URL=redis://redis:6379/0

# ================================
# Authentication & Security
# ================================

# JWT secret key for token signing
# GitHub Secret: JWT_SECRET_KEY
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=${JWT_SECRET_KEY}

# JWT algorithm for token signing
JWT_ALGORITHM=HS256

# Access token expiration time in hours
ACCESS_TOKEN_EXPIRE_HOURS=8

# CORS allowed origins (comma-separated list)
# Production domains (frontend + API) and development Tailscale domain
CORS_ORIGINS=https://siufu.tinsu.ai,https://api.siufu.tinsu.ai,http://tinxudev.airplane-manta.ts.net:8779

# ================================
# External API Keys
# ================================

# OpenRouter API key for LLM access (GPT-5)
# GitHub Secret: OPENROUTER_API_KEY
# Get from: https://openrouter.ai/
OPENROUTER_API_KEY=${OPENROUTER_API_KEY}

# Google Cloud Project ID for Document AI
# GitHub Secret: GOOGLE_CLOUD_PROJECT_ID
# Find in: Google Cloud Console → Project Settings
GOOGLE_CLOUD_PROJECT_ID=${GOOGLE_CLOUD_PROJECT_ID}

# Google Cloud Location for Document AI processor
# GitHub Secret: GOOGLE_CLOUD_LOCATION
# Example: us (US), eu (EU), asia-northeast1 (Tokyo)
GOOGLE_CLOUD_LOCATION=${GOOGLE_CLOUD_LOCATION}

# Google Cloud Document AI Processor ID
# GitHub Secret: GOOGLE_CLOUD_PROCESSOR_ID
# Find in: Google Cloud Console → Document AI → Processors
GOOGLE_CLOUD_PROCESSOR_ID=${GOOGLE_CLOUD_PROCESSOR_ID}

# Note: GCP Service Account JSON key is stored separately at:
# ./secrets/gcp-sa-key.json
# GitHub Secret: GCP_SA_KEY_JSON (full JSON content)

# ================================
# Monitoring & Error Tracking
# ================================

# Sentry DSN for error tracking (optional)
# GitHub Secret: SENTRY_DSN
# Get from: Sentry.io project settings
# Leave empty to disable Sentry
SENTRY_DSN=${SENTRY_DSN}

# ================================
# Frontend Configuration
# ================================

# Backend API URL for frontend
# In production, this uses the dedicated API subdomain
# Nginx reverse proxy handles SSL termination and routing
NEXT_PUBLIC_API_URL=https://api.siufu.tinsu.ai

# ================================
# Production Notes
# ================================
#
# 1. Network Configuration:
#    - All services use internal Docker network 'siufu-network'
#    - Frontend → Backend: Uses internal service name 'backend:8000'
#    - Backend → Database: Uses internal service name 'postgres:5432'
#    - Backend → Redis: Uses internal service name 'redis:6379'
#    - External access goes through Nginx reverse proxy
#
# 2. SSL/TLS:
#    - Handled by Cloudflare (Full Strict mode)
#    - Nginx uses Cloudflare Origin Certificate
#    - All external traffic is HTTPS
#    - Two separate domains: siufu.tinsu.ai (frontend) and api.siufu.tinsu.ai (backend)
#
# 3. Port Mapping:
#    - Frontend: Host 8779 → Container 3000
#    - Backend: Host 8780 → Container 8000
#    - PostgreSQL: Host 8781 → Container 5432 (internal only)
#    - Redis: Host 8782 → Container 6379 (internal only)
#
# 4. Volumes:
#    - postgres-data: Database persistent storage
#    - redis-data: Redis persistent storage
#    - uploaded-files: User uploaded files
#    - exports: Generated export files
#    - screenshots: Playwright test screenshots
#
# 5. Health Checks:
#    - PostgreSQL: pg_isready command
#    - Redis: redis-cli ping command
#    - Backend: HTTP GET /health endpoint
#    - Celery Worker: celery inspect ping command
#
# 6. Deployment Process:
#    - GitHub Actions triggers on push to main
#    - Runs tests (optional)
#    - SSH to server
#    - Syncs code via rsync
#    - Runs: docker compose down
#    - Runs: docker compose up -d --build
#    - Runs database migrations
#    - Performs health checks
#
# 7. Security Best Practices:
#    - Never commit this file with actual values
#    - Rotate secrets regularly (quarterly recommended)
#    - Use strong passwords (minimum 32 characters)
#    - Enable Cloudflare Bot Fight Mode
#    - Keep system and dependencies updated
#    - Monitor logs for suspicious activity
#
# 8. Backup Strategy:
#    - Database: Regular PostgreSQL dumps
#    - Environment: Backup .env file before updates
#    - Volumes: Consider volume snapshots
#    - See docs/DEPLOYMENT.md for backup procedures
#
# ================================
