# ================================
# Environment Variables Template
# ================================
#
# INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in actual values for each variable below
# 3. Never commit the .env file to version control
#
# ================================

# ================================
# Database Configuration
# ================================

# PostgreSQL database name (default: customs_db)
POSTGRES_DB=customs_db

# PostgreSQL password (REQUIRED - change this!)
# Example: my_secure_password_123
POSTGRES_PASSWORD=change_me_in_production

# Full database URL for backend connection
# Format: postgresql+asyncpg://user:password@host:port/database
# Example: postgresql+asyncpg://postgres:my_secure_password_123@postgres:5432/customs_db
DATABASE_URL=postgresql+asyncpg://postgres:change_me_in_production@postgres:5432/customs_db

# ================================
# Redis Configuration
# ================================

# Redis connection URL for caching
# Example: redis://redis:6379/0
REDIS_URL=redis://redis:6379/0

# Celery broker URL (uses Redis)
# Example: redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# ================================
# Authentication & Security
# ================================

# JWT secret key for token signing (REQUIRED - use a strong random string!)
# Generate with: openssl rand -hex 32
# Example: 09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
JWT_SECRET_KEY=change_me_to_a_random_secret_key

# CORS allowed origins (comma-separated list)
# Example: http://localhost:3000,http://localhost:8879,https://app.example.com
# Tailscale domain: http://tinxudev.airplane-manta.ts.net:8879,http://tinxudev.airplane-manta.ts.net:8880
CORS_ORIGINS=http://localhost:3000,http://localhost:8879,http://tinxudev.airplane-manta.ts.net:8879,http://tinxudev.airplane-manta.ts.net:8880

# ================================
# External API Keys
# ================================

# OpenRouter API key for LLM access (GPT-5)
# Get from: https://openrouter.ai/
# Example: sk-or-v1-abc123...
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google Cloud Project ID for Document AI
# Find in: Google Cloud Console -> Project Settings
# Example: my-project-id-12345
GOOGLE_CLOUD_PROJECT_ID=your_google_cloud_project_id

# Google Cloud Location for Document AI processor
# Example: us (US), eu (EU), asia-northeast1 (Tokyo)
# Default: us
GOOGLE_CLOUD_LOCATION=us

# Google Cloud Document AI Processor ID
# Find in: Google Cloud Console -> Document AI -> Processors
# Example: abc123def456
GOOGLE_CLOUD_PROCESSOR_ID=your_processor_id_here

# ================================
# Monitoring & Error Tracking
# ================================

# Sentry DSN for error tracking (optional)
# Get from: Sentry.io project settings
# Example: https://abc123@o123456.ingest.sentry.io/123456
# Leave empty to disable Sentry
SENTRY_DSN=

# ================================
# Frontend Configuration
# ================================

# Backend API URL for frontend (use internal Docker network name for production)
# Development: http://localhost:8000
# Production (Docker): http://backend:8000
# Tailscale: http://tinxudev.airplane-manta.ts.net:8880
NEXT_PUBLIC_API_URL=http://localhost:8880

# ================================
# Additional Notes
# ================================
#
# - For local development outside Docker, use localhost instead of service names
# - For production, ensure all "change_me" values are replaced with secure values
# - Keep your .env file secure and never share it publicly
# - Service account key file must be placed at: ./secrets/gcp-sa-key.json
#
