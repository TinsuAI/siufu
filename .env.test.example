# ===========================================
# Test Environment Variables
# ===========================================
#
# Copy this file to .env.test and fill in the values for testing
#

# ----------------------------------------
# Backend Test Configuration
# ----------------------------------------

# Test Database (PostgreSQL)
# Separate database for tests to avoid affecting development data
DATABASE_URL_TEST=postgresql+asyncpg://test:test@localhost:5432/logai_test

# Secret key for JWT tokens (can be any string for tests)
SECRET_KEY_TEST=test_secret_key_change_in_production_123456789

# Google Document AI (Mock API Key)
# Use a mock key for tests - actual API calls are mocked in fixtures
GOOGLE_CLOUD_PROJECT_TEST=test-project
GOOGLE_CLOUD_KEY_TEST=/path/to/mock-service-account.json

# OpenRouter API (Mock API Key)
# Use a mock key for tests - actual API calls are mocked in fixtures
OPENROUTER_API_KEY_TEST=mock_api_key_do_not_use_in_production

# ----------------------------------------
# Frontend Test Configuration
# ----------------------------------------

# API Base URL for E2E tests
# Points to the backend server running in Docker or locally
NEXT_PUBLIC_API_URL_TEST=http://localhost:8000

# ----------------------------------------
# E2E Test Configuration
# ----------------------------------------

# Base URL for Playwright tests (Next.js frontend)
PLAYWRIGHT_BASE_URL=http://localhost:3000

# Test user credentials for E2E login tests
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=testpassword123

# Headless mode for CI (set to 'false' for local debugging)
PLAYWRIGHT_HEADLESS=true

# ----------------------------------------
# Docker Test Configuration
# ----------------------------------------

# Database credentials for Docker Compose test environment
POSTGRES_USER=test
POSTGRES_PASSWORD=test
POSTGRES_DB=logai_test

# Redis configuration for Celery task queue tests
REDIS_URL_TEST=redis://localhost:6379/1

# ----------------------------------------
# Coverage Targets
# ----------------------------------------

# Backend coverage target (percentage)
BACKEND_COVERAGE_TARGET=70

# Frontend coverage target (percentage)
FRONTEND_COVERAGE_TARGET=60

# ----------------------------------------
# Notes
# ----------------------------------------
#
# 1. Never commit .env.test with real credentials to version control
# 2. All external API calls should be mocked in tests to avoid costs
# 3. Test database should be separate from development database
# 4. For CI/CD, these values will be set in GitHub Actions secrets
#
