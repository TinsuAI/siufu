  "accuracy_thresholds": {
    "critical_fields": {
      "description": "Fields that must be 100% accurate",
      "match_type": "exact",
      "required_accuracy": 1.0,
      "fields": [
        "importer.tax_code",
        "invoice.invoice_number",
        "invoice.invoice_total",
        "products[].hs_code",
        "products[].quantity_1",
        "products[].invoice_unit_price",
        "shipping_transport.bill_of_lading_number",
        "certificate_of_origin.co_number"
      ]
    },
    "important_fields": {
      "description": "Fields that should be 90% accurate with fuzzy matching",
      "match_type": "fuzzy",
      "required_accuracy": 0.9,
      "fuzzy_threshold": 0.85,
      "fields": [
        "importer.name",
        "importer.address",
        "exporter.name",
        "exporter.address_line1",
        "exporter.address_line2",
        "exporter.address_line3",
        "shipping_transport.vessel_name",
        "products[].product_description"
      ]
    },
    "optional_fields": {
      "description": "Fields that are nice to have with 70% accuracy",
      "match_type": "fuzzy",
      "required_accuracy": 0.7,
      "fields": [
        "importer.phone",
        "products[].brand_name",
        "package_container.package_marks"
      ]
    },
    "calculated_fields": {
      "description": "Calculated fields with tolerance for exchange rate variations",
      "match_type": "numeric_tolerance",
      "tolerance_percent": 0.01,
      "fields": [
        "invoice.total_taxable_value_vnd",
        "tax_summary.total_tax_amount_vnd"
      ]
    }
  }
}
