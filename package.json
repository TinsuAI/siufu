{
  "name": "logai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test:backend": "cd backend && source venv/bin/activate && pytest",
    "test:frontend": "cd frontend && npm run test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "npm run test:backend && npm run test:frontend && npm run test:e2e",
    "playwright:install": "playwright install --with-deps",
    "bmad:refresh": "bmad-method install -f -i codex",
    "bmad:list": "bmad-method list:agents",
    "bmad:validate": "bmad-method validate"
  },
  "devDependencies": {
    "@playwright/test": "1.48.2",
    "husky": "9.1.7"
  }
}
